# Local development configuration. `serve` reads the process environment.
DATABASE_URL=postgres://scheduler:scheduler-local-password@127.0.0.1:55432/scheduler
POSTGRES_PASSWORD=scheduler-local-password
SCHEDULER_BIND=127.0.0.1:8080
SCHEDULER_API_KEYS='{"local":"change-this-local-api-key"}'
SCHEDULER_WORKERS=8
SCHEDULER_POLL_MS=500
SCHEDULER_RULE_TIMEOUT_MS=2000
# Enables the loopback demo receiver; the binary's default is false.
SCHEDULER_ALLOW_PRIVATE_TARGETS=true
RUST_LOG=scheduler_service=info,tower_http=info
